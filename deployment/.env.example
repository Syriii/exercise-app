APP_PORT=3000
APP_IMAGE_TAG=local
APP_BUILD_REVISION=local
NODE_BASE_IMAGE=node:24.19.0-bookworm-slim
POSTGRES_IMAGE=postgres:18.6-bookworm
DEBIAN_MIRROR=http://deb.debian.org/debian
LOG_LEVEL=info
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_HEARTBEAT_STALE_SECONDS=45
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
DEEPSEEK_TIMEOUT_MS=120000
IMAGE_UPLOAD_MAX_BYTES=8388608
EXPORT_MAX_BYTES=67108864
EXPORT_RETENTION_HOURS=168
MEDIA_CLEANUP_INTERVAL_SECONDS=3600
MAX_ACCOUNTS=10
AUTH_RATE_LIMIT_MAX=30
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
WRITE_RATE_LIMIT_MAX=240
WRITE_RATE_LIMIT_WINDOW_SECONDS=60
IMAGE_RATE_LIMIT_MAX=20
IMAGE_RATE_LIMIT_WINDOW_SECONDS=3600
MAX_ACTIVE_IMAGE_ANALYSES_PER_ACCOUNT=3
TEMP_MEDIA_MAX_BYTES_PER_ACCOUNT=268435456
# Optional private exercise media directory on the host. Keep empty unless
# compose.exercise-media.yaml is enabled; use an existing absolute path.
EXERCISE_MEDIA_HOST_PATH=
BACKUP_RETENTION_DAYS=14
BACKUP_DIRECTORY=./backups
BACKUP_MIRROR_DIRECTORY=
POSTGRES_DB=exercise
POSTGRES_USER=exercise
